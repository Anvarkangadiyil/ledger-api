# Copy this file to `.env.development.local` (or `.env.production.local`)
# and adjust the values for your environment. Never commit real secrets.

PORT=3000
NODE_ENV=development

# MongoDB must run as a replica set or sharded cluster because transaction
# creation, balance updates, and transfers use multi-document transactions.
DB_URI=mongodb://127.0.0.1:27017/ledger?replicaSet=rs0

# Optional: override the database used by `npm test`. Its name must contain
# "test" because the test suites delete ledger data.
# TEST_DB_URI=mongodb://127.0.0.1:27018/ledger_api_test?replicaSet=rs0
